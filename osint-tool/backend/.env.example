# ─────────────────────────────────────────────────────────────
# OPTIONAL API keys.
# The free version works WITHOUT any of these.
# To enable a key-based module, copy this file to .env and fill in
# the key — the module activates automatically once its key is set.
# ─────────────────────────────────────────────────────────────

# SHODAN_API_KEY=        # enables the "shodan" module (domain exposure: ports, services, CVEs)
# HIBP_API_KEY=          # enables the "hibp" module (email breach lookup)
# HUNTER_API_KEY=
# SECURITYTRAILS_API_KEY=
# NUMVERIFY_API_KEY=

# ─────────────────────────────────────────────────────────────
# OPTIONAL infrastructure (all have safe defaults; leave unset to disable).
# ─────────────────────────────────────────────────────────────

# Redis cache for scan results (no-op if unset or unreachable).
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600                       # seconds a cached scan stays valid

# Persistent scan history (SQLite file path; defaults to ./ariadne_history.db).
# HISTORY_DB=ariadne_history.db
