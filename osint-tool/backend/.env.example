# ─────────────────────────────────────────────────────────────
# Copy this file to `backend/.env` and edit what you need.
# It is loaded automatically by app/core/config.py (pydantic-settings),
# both when running `uvicorn app.main:app` locally and inside Docker.
# Every value below is OPTIONAL: the defaults are what the free,
# local-only setup uses.
# ─────────────────────────────────────────────────────────────

# ---------- Optional API keys ----------
# A key-based module activates automatically as soon as its key is set.
# (Only these two are used; there is no module reading any other key.)
# SHODAN_API_KEY=        # enables the "shodan" module (domain exposure: ports, services, CVEs)
# HIBP_API_KEY=          # enables the "hibp" module (email breach lookup)

# ---------- Cache (optional Redis) ----------
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600                 # seconds a cached scan stays valid
# CACHE_RETRY_SECONDS=60         # how long before retrying a Redis connection that failed

# ---------- Persistent history (SQLite) ----------
# HISTORY_DB=ariadne_history.db
# HISTORY_MAX_ROWS=5000          # oldest rows above this count are pruned
# HISTORY_RETENTION_DAYS=90      # rows older than this are pruned

# ---------- Scan execution limits ----------
# SCAN_TIMEOUT=120               # hard ceiling for a whole scan, in seconds
# MODULE_TIMEOUT=60              # hard ceiling for any single module
# WHOIS_TIMEOUT=20               # python-whois is blocking and has no timeout of its own
# HTTP_TIMEOUT=10.0
# GEO_PROVIDER_TIMEOUT=4.0       # per-source budget in the IP geolocation consensus:
#                                # the four providers are queried at once, so without
#                                # this one stalled source held the whole scan
# DOH_TIMEOUT=3.0                # per-endpoint budget for the DNS-over-HTTPS fallback
# MAX_TARGET_LENGTH=253

# ---------- Username module (Maigret) ----------
# MAIGRET_TOP_SITES=150          # more sites = better coverage, slower scans
# MAIGRET_TIMEOUT=10             # seconds per site

# ---------- API surface ----------
# Comma-separated browser origins allowed to call the API.
# "*" is convenient locally but means ANY website you visit can drive your
# backend and read your scan history. Restrict it before exposing the API.
# CORS_ORIGINS=http://localhost:8080,https://your-dashboard.example
#
# When set, every endpoint requires the header `X-API-Key: <value>`.
# API_KEY=
#
# Rate limits (slowapi syntax). /scan is limited separately because a single
# username scan fans out to ~150 outbound requests.
# RATE_LIMIT=60/minute
# SCAN_RATE_LIMIT=10/minute

# ---------- Outbound safety ----------
# Modules that fetch a user-supplied host refuse private/reserved addresses
# (SSRF protection). Only enable on a trusted, isolated network.
# ALLOW_PRIVATE_TARGETS=false
#
# ip-api.com offers HTTPS only on paid plans, so the target IP travels in
# cleartext. Set to false to drop it from the geolocation consensus.
# ENABLE_INSECURE_IPAPI=true

# ---------- Logging ----------
# LOG_LEVEL=INFO
# LOG_JSON=false                 # true = one JSON object per line, for log collectors
